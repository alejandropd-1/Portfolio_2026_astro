---
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '@fontsource/roboto-mono/400.css';

import "@/styles/main.scss";
import { getEntry } from 'astro:content';
import Navigation from "@/components/Navigation";
import Footer from "@/components/Footer";

const footerEntry = await getEntry('global', 'footer');

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AleDesign | Alejandro Delgado - Multimedia Designer",
  description = "Portfolio of Alejandro Delgado, a Multimedia Designer and Creative Developer specializing in high-end digital experiences, editorial design, and technical precision."
} = Astro.props;
---
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KNVXGZVD');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Multimedia Designer, Creative Developer, UX/UI Design, Portfolio, Editorial Design, Alejandro Delgado, AleDesign, Motion Design, Web Development" />
    <meta name="author" content="Alejandro Delgado" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content="https://aledesign.dev" />
    <meta property="og:site_name" content="AleDesign" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/banner-background.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/banner-background.png" />

    <style is:global>
      :root {
        --font-sans: 'Inter', sans-serif;
        --font-mono: 'Roboto Mono', monospace;
      }
    </style>

    <script is:inline>
      // Restore theme class before React renders (prevents flash)
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KNVXGZVD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="bg-energy-grid" aria-hidden="true">
      <div class="eg-sweep eg-sweep--right"></div>
      <div class="eg-sweep eg-sweep--down"></div>
      <div class="eg-spot eg-spot--tertiary"></div>
      <div class="eg-spot eg-spot--secondary"></div>
      <div class="eg-spot eg-spot--primary"></div>
      <div class="eg-glow eg-glow--tertiary"></div>
      <div class="eg-glow eg-glow--secondary"></div>
      <div class="eg-glow eg-glow--primary"></div>
      <div class="eg-beams">
        <!-- Primary: 2 beams (v+h) @ 0.4s apart -->
        <div class="eg-beam eg-beam--v eg-beam--m1" style="--bp:384px; --bc:var(--clr-brand-primary-rgb);    --bdy:0s;   --bd:9s;"></div>
        <div class="eg-beam eg-beam--h eg-beam--m1" style="--bp:288px; --bc:var(--clr-brand-primary-rgb);    --bdy:0.4s; --bd:9s;"></div>
        <!-- Tertiary: 2 beams -->
        <div class="eg-beam eg-beam--v eg-beam--m2" style="--bp:720px; --bc:var(--clr-brand-tertiary-rgb);   --bdy:1s;   --bd:8s;"></div>
        <div class="eg-beam eg-beam--h eg-beam--m2" style="--bp:480px; --bc:var(--clr-brand-tertiary-rgb);   --bdy:1.4s; --bd:8s;"></div>
        <!-- Secondary: 2 beams -->
        <div class="eg-beam eg-beam--v eg-beam--m3" style="--bp:336px; --bc:var(--clr-brand-secondary-rgb);  --bdy:2.5s; --bd:10s;"></div>
        <div class="eg-beam eg-beam--h eg-beam--m3" style="--bp:624px; --bc:var(--clr-brand-secondary-rgb);  --bdy:3s;   --bd:10s;"></div>
      </div>
      <div class="eg-vignette"></div>
    </div>

    <Navigation client:idle pathname={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer
      client:idle
      copyright={footerEntry?.data?.copyright}
      links={footerEntry?.data?.links}
    />
  </body>
</html>
