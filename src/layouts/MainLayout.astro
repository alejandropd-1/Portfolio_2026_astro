---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/roboto-mono/400.css';

import "@/styles/main.scss";
import { getEntry } from 'astro:content';
import Navigation from "@/components/Navigation";
import Footer from "@/components/Footer";

const footerEntry = await getEntry('global', 'footer');

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AleDesign | Alejandro Delgado - Multimedia Designer",
  description = "Portfolio of Alejandro Delgado, a Multimedia Designer and Creative Developer specializing in high-end digital experiences, editorial design, and technical precision."
} = Astro.props;
---
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JGHRGD2X1R"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JGHRGD2X1R');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Multimedia Designer, Creative Developer, UX/UI Design, Portfolio, Editorial Design, Alejandro Delgado, AleDesign, Motion Design, Web Development" />
    <meta name="author" content="Alejandro Delgado" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content="https://aledesign.dev" />
    <meta property="og:site_name" content="AleDesign" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/banner-background.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/banner-background.png" />

    <style is:global>
      :root {
        --font-sans: 'Inter', sans-serif;
        --font-mono: 'Roboto Mono', monospace;
      }
    </style>

    <script is:inline>
      // Restore theme class before React renders (prevents flash)
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KNVXGZVD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="bg-energy-grid" aria-hidden="true">
      <div class="eg-spot eg-spot--tertiary"></div>
      <div class="eg-spot eg-spot--secondary"></div>
      <div class="eg-spot eg-spot--primary"></div>
    </div>

    <Navigation client:load pathname={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer
      client:idle
      copyright={footerEntry?.data?.copyright}
      links={footerEntry?.data?.links}
    />
    <script is:inline>
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        var GRID = 48;
        var RADIUS = GRID * 1.6;

        var bg = document.querySelector('.bg-energy-grid');
        if (!bg) return;

        var canvas = document.createElement('canvas');
        // width/height 100% + inset:0 hace que el CSS size == parent size
        canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;mix-blend-mode:screen;';
        bg.appendChild(canvas);

        var ctx = canvas.getContext('2d');

        function updateBlendMode() {
          canvas.style.mixBlendMode = document.documentElement.classList.contains('light')
            ? 'multiply'
            : 'screen';
        }
        updateBlendMode();

        function resize() {
          // El bitmap se ajusta al tamaño CSS real del canvas
          var r = canvas.getBoundingClientRect();
          canvas.width  = Math.round(r.width);
          canvas.height = Math.round(r.height);
        }
        resize();
        window.addEventListener('resize', resize);

        function getColor() {
          return getComputedStyle(document.documentElement)
            .getPropertyValue('--clr-brand-primary-rgb').trim() || '176,255,146';
        }

        var cx = -9999, cy = -9999;
        var pending = false;

        function draw() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          if (cx < 0) return;

          var color = getColor();
          var x0 = Math.floor((cx - RADIUS - GRID) / GRID);
          var x1 = Math.ceil( (cx + RADIUS + GRID) / GRID);
          var y0 = Math.floor((cy - RADIUS - GRID) / GRID);
          var y1 = Math.ceil( (cy + RADIUS + GRID) / GRID);

          for (var gx = x0; gx <= x1; gx++) {
            for (var gy = y0; gy <= y1; gy++) {
              var cellCx = gx * GRID + GRID / 2;
              var cellCy = gy * GRID + GRID / 2;
              var dist = Math.sqrt((cx - cellCx) * (cx - cellCx) + (cy - cellCy) * (cy - cellCy));
              if (dist >= RADIUS) continue;
              var alpha = (1 - dist / RADIUS) * 0.18;
              ctx.fillStyle = 'rgba(' + color + ',' + alpha + ')';
              ctx.fillRect(gx * GRID, gy * GRID, GRID, GRID);
            }
          }
        }

        document.addEventListener('mousemove', function (e) {
          // Restamos el offset real del canvas para que las coords sean locales
          var r = canvas.getBoundingClientRect();
          cx = e.clientX - r.left;
          cy = e.clientY - r.top;
          if (pending) return;
          pending = true;
          requestAnimationFrame(function () { draw(); pending = false; });
        });

        document.addEventListener('mouseleave', function () {
          cx = cy = -9999;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        });

        new MutationObserver(function () {
          updateBlendMode();
          draw();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      })();
    </script>
  </body>
</html>
