---
import { getCollection, render } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectDetailLayout from '@/components/ProjectDetailLayout';
import customComponents from '@/components/mdx';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const sorted = allProjects
    .filter(p => p.data.showInPortfolio !== false)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

  return sorted.map((entry, index) => {
    const next = sorted[(index + 1) % sorted.length];
    return {
      params: { slug: entry.id },
      props: { entry, nextSlug: next.id },
    };
  });
}

const { entry, nextSlug } = Astro.props;
const { Content } = await render(entry);

const projectData = {
  ...entry.data,
  slug: entry.id
};
---

<MainLayout title={`${entry.data.title} | AleDesign`}>
  <ProjectDetailLayout client:load project={projectData} nextLink={`/projects/${nextSlug}`}>
    <Content components={customComponents} />
  </ProjectDetailLayout>
</MainLayout>
