---
import { getCollection, getEntry } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientArchive from '@/components/ClientArchive';

const page = await getEntry('pages', 'archive');

const allProjects = await getCollection('projects');
const projects = allProjects
  .map(p => ({ ...p.data, slug: p.id }))
  .sort((a, b) => {
    const yearA = parseInt(a.year || '0');
    const yearB = parseInt(b.year || '0');
    return yearB - yearA;
  });
---

<MainLayout title={page ? `Archive | ${page.data.title}` : 'Archive'}>
  <ClientArchive client:load projects={projects} pageMeta={page?.data} />
</MainLayout>
