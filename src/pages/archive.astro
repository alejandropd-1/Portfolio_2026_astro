---
import { getCollection } from 'astro:content';
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientArchive from '@/components/ClientArchive';

const tinaProps = await client.queries.pages({ relativePath: 'archive.mdx' });
const title = (tinaProps.data.pages as any).title ?? 'Project Archive';

const allProjects = await getCollection('projects');
const projects = allProjects
  .map(p => ({ ...p.data, slug: p.id }))
  .sort((a, b) => {
    const yearA = parseInt(a.year || '0');
    const yearB = parseInt(b.year || '0');
    return yearB - yearA;
  });
---

<MainLayout title={`Archive | ${title}`}>
  <ClientArchive
    client:load
    projects={projects}
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
  />
</MainLayout>
