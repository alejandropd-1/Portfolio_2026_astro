---
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientAbout from '@/components/ClientAbout';

const tinaProps = await client.queries.pages({ relativePath: 'about.mdx' });
const title = (tinaProps.data.pages as any).title ?? 'About';
---

<MainLayout title={`About | ${title}`}>
  <ClientAbout
    client:load
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
  />
</MainLayout>
